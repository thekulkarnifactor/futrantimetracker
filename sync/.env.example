# Copy to sync/.env and fill in. NEVER commit the real .env.

# Supabase Dashboard -> Settings -> API -> service_role key (NOT the anon key)
SUPABASE_URL=https://ouqeqgmgwcdesezpitlo.supabase.co
SUPABASE_SERVICE_KEY=

# How often to sync during the work window, in seconds
SYNC_INTERVAL_SECONDS=60
# Outside the window only the day close-out runs, this often
IDLE_INTERVAL_SECONDS=600
SYNC_WINDOW=06:00-23:59
TZ_NAME=Asia/Kolkata

# Browsers running at once (each ~150-300 MB RAM). 0 = everyone at once.
MAX_CONCURRENT_USERS=4

# After this many failed logins in a row, pause that user so greytHR doesn't lock the account
LOGIN_FAILURE_LIMIT=3
LOGIN_BACKOFF_MINUTES=30

# Screenshots of failed scrapes are deleted after this many days
DEBUG_RETENTION_DAYS=3

# 0 = show the browser window (debugging only)
HEADLESS=1
